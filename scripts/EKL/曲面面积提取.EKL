// ============================================================
// 功能：提取曲面面积并输出到参数（用于机翼/机身蒙皮面积估算）
// 环境：CATIA V5 知识工程
// ============================================================

// 创建结果参数
Parameters.CreateDimension("蒙皮面积", "AREA", 0m2)

// 将曲面面积赋给参数（需配合 UDF 或公式绑定曲面）
// "曲面1.Area" 为占位，实际应替换为你的曲面特征
Parameters.CreateFormula("蒙皮面积", "曲面1.Area")
